[Unit]
Description=Record Locator FHIR Service
After=network.target postgresql.service opensearch.service
Wants=postgresql.service

[Service]
Type=simple
User=record-locator
Group=record-locator
WorkingDirectory=/opt/record-locator
EnvironmentFile=/etc/record-locator/record-locator.env
ExecStart=/usr/bin/java -jar /opt/record-locator/record-locator.jar
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=record-locator

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
