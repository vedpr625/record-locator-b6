# Record Locator - Azure VM DEMO, NO AUTHENTICATION (no Keycloak needed).
# !! Every endpoint is open to anyone who can reach the port, including patient
# !! search and writes. Restrict port 8080 in the Azure NSG to your own IP and use
# !! only dummy data. Install as /etc/record-locator/record-locator.env.
#
# The "dev" profile turns authentication off but hard-codes an in-memory database;
# the SPRING_DATASOURCE_* variables below override that so data is kept in a file.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:h2:file:/var/lib/record-locator/db;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
# Both must hold the same value. H2 fixes it when the file is first created.
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

RL_OPENSEARCH_ENABLED=false
RL_CONSENT_DEFAULT_ACCESSIBLE=true
SERVER_PORT=8080
