# Record Locator - Azure VM DEMO configuration (H2 file database, no OpenSearch).
# Installed to /etc/record-locator/record-locator.env (chmod 600) by setup-demo.sh.

# -- Database: embedded H2 in a file (survives restarts; NOT for production) -------------
# MODE=PostgreSQL lets the existing Flyway migrations run unchanged.
# DB_PASSWORD: setup-demo.sh replaces CHANGE_ME with a random value on first install.
# H2 fixes the password when the file is first created - do not change it afterwards.
DB_URL=jdbc:h2:file:/var/lib/record-locator/db;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=CHANGE_ME

# -- Keycloak (REQUIRED: the app rejects every /fhir request without a valid token) -----
# Must exactly match the "iss" claim of the tokens and be reachable from this VM.
IDP_ISSUER_URI=https://CHANGE-ME-keycloak-host/realms/bundle-5

# -- OpenSearch off: _name searches return nothing, everything else works ---------------
RL_OPENSEARCH_ENABLED=false

# -- Consent default (opt-out model) ----------------------------------------------------
RL_CONSENT_DEFAULT_ACCESSIBLE=true

# -- mTLS header: leave false unless a reverse proxy verifies client certs and strips it --
MTLS_HEADER_ENABLED=false

# -- ITI-68 (Binary/<id>) only redirects to these HTTPS hosts; empty = all blocked --------
#RL_CONTENT_URL_ALLOWED_HOSTS=pacs.example.org,emr.example.org

SERVER_PORT=8080
