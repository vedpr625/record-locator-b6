# Record Locator — production environment variables
# Copy this file to /etc/record-locator/record-locator.env on your Lightsail instance
# chmod 600 /etc/record-locator/record-locator.env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/record_locator
DB_USER=record_locator
DB_PASSWORD=CHANGE_ME

# ── Keycloak (bundle-5 realm) ───────────────────────────────────────────────
IDP_ISSUER_URI=https://keycloak.registry.dev.internal.asthrahealthtech.com/realms/bundle-5

# ── OpenSearch ─────────────────────────────────────────────────────────────
RL_OPENSEARCH_ENABLED=true
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=rl-patients
# Max PHNs returned per name search (avoids huge SQL IN clauses)
OPENSEARCH_MAX_NAME_RESULTS=200

# ── Consent model (Sri Lanka = opt-out → true) ─────────────────────────────
RL_CONSENT_DEFAULT_ACCESSIBLE=true

# ── mTLS header (enable once nginx/haproxy is in front doing real cert verify)
MTLS_HEADER_ENABLED=false

# ── Server ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── DICOM/Orthanc (only needed if polling DICOM worklist) ──────────────────
#ORTHANC_BASE_URL=http://localhost:8042
#FACILITY_HIN=LKA-HOSPITAL-001
#FACILITY_NAME=General Hospital Colombo
